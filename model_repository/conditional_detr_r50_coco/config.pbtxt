name: "conditional_detr_r50_coco"
backend: "python"
max_batch_size : 2
input [
  {
    name: "inputs"
    data_type: TYPE_FP32
    format: FORMAT_NCHW
    dims: [3, -1, -1]
  }
]
output [
  {
    name: "bboxes"
    data_type: TYPE_FP32
    dims: [-1, 4]
  }
]
output [
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [-1]
  }
]
output [
  {
    name: "labels"
    data_type: TYPE_INT64
    dims: [-1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [0]
  }
]
dynamic_batching {
    preferred_batch_size: [1, 2]
    max_queue_delay_microseconds: 3000000
}
